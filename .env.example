# Which BrokerClient implementation run_cycle.py uses.
#   simulated (default) - purely local, in-memory paper account, no API keys needed
#   alpaca              - real Alpaca paper trading account, requires the keys below
BROKER_PROVIDER=simulated

# Alpaca PAPER trading credentials (only needed if BROKER_PROVIDER=alpaca)
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Risk parameters
MAX_DRAWDOWN_PCT=0.15
POSITION_FRACTION=0.25
