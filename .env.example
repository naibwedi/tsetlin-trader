# Which BrokerClient run_cycle.py uses.
#   simulated - purely local in-memory account, no keys needed (no price movement)
#   alpaca    - your Alpaca PAPER account, needs the keys below
BROKER_PROVIDER=simulated

# Which SignalProvider run_cycle.py uses.
#   blend       - recommended deterministic three-strategy paper controller
#   logic_alpha - fitted model from logic-alpha-tm, needs TIINGO_API_TOKEN
#   mock        - deterministic placeholder for offline demos and tests
SIGNAL_PROVIDER=blend
# tmu (default: the Tsetlin Machine, needs `pip install -e ".[tm]"`) | bernoulli | logistic | boosted_tree
SIGNAL_MODEL=tmu
SHADOW_MODELS=tmu,bernoulli
# How far back to train. The research protocol starts in 2008.
SIGNAL_HISTORY_START=2008-01-01

# Tiingo free-tier token: https://www.tiingo.com/account/api/token
TIINGO_API_TOKEN=your_tiingo_token_here

# Alpaca PAPER keys: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Optional: Discord/Slack-style webhook that receives HALT, refusal and failure alerts
ALERT_WEBHOOK_URL=

# Risk parameters
MAX_DRAWDOWN_PCT=0.15
POSITION_FRACTION=0.25

# Required for Alpaca weekly mode: private, durable, account-specific directory.
# Never use a shared GitHub checkout as the authoritative state store.
TT_STATE_DIR=
# Only for an explicitly reviewed, flat, NEW account history. Remove after setup.
ALLOW_FRESH_STATE=0
